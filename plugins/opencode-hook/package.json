{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@conspectus/opencode-hook",
  "version": "0.3.0",
  "description": "OpenCode plugin (1.x root entrypoint, 2.x server and TUI entrypoints in dist/v2) that reports each session's live state and the session a pane shows to `conspectus hook write opencode`.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.19",
    "@opencode/plugin": "2.0.32",
    "@types/node": "22.13.9",
    "typescript": "5.8.2"
  }
}
