{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@conspectus/opencode-hook",
  "version": "0.1.0",
  "description": "OpenCode plugin that forwards session lifecycle events to `conspectus hook write opencode` for mux↔session attribution.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.19",
    "@types/node": "22.13.9",
    "typescript": "5.8.2"
  }
}
